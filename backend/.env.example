# --- Database ---
# PostgreSQL connection string. Leave unset for local dev / CI — the app
# falls back to a local SQLite file (./leadtriage.db) automatically.
DATABASE_URL=postgresql://leadtriage:leadtriage@localhost:5432/leadtriage

# --- JWT auth (single admin user) ---
# Secret used to sign JWTs. Generate a real random value in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-this-to-a-random-secret-in-production

# Admin login credentials. ADMIN_PASSWORD_HASH is a bcrypt hash, not plaintext.
# Generate one with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash

# --- AI layer (Groq, free tier) ---
# Leave unset to run entirely on the deterministic mock classifier (demo mode
# works with zero paid/keyed services). Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- Notifications ---
# Slack-compatible webhook URL (or any endpoint accepting a JSON POST) used
# for new-lead and follow-up notifications. Leave unset to log-only (no
# outbound network call) — the default "mock webhook" demo-mode behavior.
NOTIFICATION_WEBHOOK_URL=
